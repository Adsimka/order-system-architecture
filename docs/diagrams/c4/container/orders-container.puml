@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Orders System - Container

Person(customer, "Customer", "Пользователь")

System_Ext(paymentProvider, "Payment Provider", "Внешний провайдер платежей")
System_Boundary(systemBoundary, "Order Processing System") {
    Container(ui, "Web UI", "React SPA", "Фронтенд в браузере")
    Container(edge, "Load Balancer", "API gateway", "Маршрутизация")
    Container(monolith, "Order Monolith", "Spring Boot", "Модульный монолит: Order Module, Payment Module, Shared Kernel")
    ContainerDb(db, "PostgreSQL", "Реляционная БД", "orders, payments, idempotency_keys")
    Container(worker, "Async Worker", "Spring Boot", "Фоновая сверка статусов, retry логика")
}

Rel(customer, ui, "Работает c UI", "HTTPS")
Rel(ui, edge, "REST API запросы", "HTTPS")
Rel(edge, monolith, "Маршрутизирует запросы создания заказа и вебхуки", "HTTP")
Rel(monolith, db, "Транзакция: Order + Idempotency (или обновление Payment)", "JDBC")
Rel(monolith, paymentProvider, "Синхронный вызов для создания HHP сессии", "HTTPS")
Rel(paymentProvider, edge, "Подписанный webhook об успешной оплате", "HTTPS")
Rel(customer, paymentProvider, "Оплачивает заказ по HHP", "HTTPS")
Rel(worker, db, "Polling: поиск зависших платежей (status=PENDING) для сверки (SKIP LOCKED)", "JDBC")
Rel(worker, paymentProvider, "Идемпотентный запрос статуса", "HTTPS")

@enduml