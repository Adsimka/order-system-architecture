@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Order Context - Context

Person(customer, "Customers", "Пользователь оформляет заказы")
System(orderSystem, "Orders System", "Модульный монолит для оформления и обработки заказов")
System_Ext(paymentProvider, "Payment Provider", "Внешний провайдер платежей")

Rel(customer, orderSystem, "1 Создает заказы, смотрит статусы")
Rel(orderSystem, paymentProvider, "2 Создает платеж", "HTTPS")
Rel(customer, paymentProvider, "3 Оплачивает заказ по HHP", "HTTPS")
Rel(paymentProvider, orderSystem, "4. Отправляет асинхронный webhook о результате оплаты", "HTTPS")

@enduml